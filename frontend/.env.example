# Set this to the backend origin. Leave empty to use the built-in demo content.
VITE_API_BASE_URL=http://localhost:8000

# Expected routes:
# GET  {VITE_API_BASE_URL}/api/careers
#      -> Career[] or { "careers": Career[] }; each item has slug, title,
#         domain, description, mark, tone, skills[], education, salary.
# POST {VITE_API_BASE_URL}/api/mentor/chat
#      body: { "message": string, "language": "en" | "kn", "profile": Profile }
#      -> { "answer": string } or { "reply": string }
